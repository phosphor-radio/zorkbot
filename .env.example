# Copy to .env and edit before starting the stack.
#
#   cp .env.example .env
#
# Every variable here is optional — the defaults shown are what you get if the
# line stays commented out. Values set here override the corresponding keys in
# zorkbot/zorkbot.toml.

# --- Radio hardware (zorkbot container) -------------------------------------

# Host path to the MeshCore serial device (see README Deploy on a Raspberry Pi).
MESHCORE_DEVICE=/dev/meshcore

# Device path inside the zorkbot container (must match --serial in compose).
MESHCORE_CONTAINER_DEVICE=/dev/meshcore

# dialout group GID on the host (20 on Raspberry Pi OS / Debian).
MESHCORE_GROUP_GID=20

# --- Bot config file --------------------------------------------------------

# Bot config file mounted into the container.
ZORKBOT_CONFIG=./zorkbot/zorkbot.toml

# --- Game service (game container) ------------------------------------------

# Session pool overrides for the game service (optional — defaults shown).
# MAX_ACTIVE_SESSIONS=8
# SESSION_IDLE_START_SECONDS=300
# SESSION_INACTIVITY_SECONDS=1800

# Where the bot reaches the game API. Under Compose the default is correct —
# "game" is the service name on the internal network. Override only for a
# local (non-Docker) run, where it is usually http://localhost:8080.
# GAME_URL=http://game:8080

# --- Admin web UI (zorkbot container) ---------------------------------------
#
# Off by default. See "Admin web UI" in README.md before exposing it: it binds
# 0.0.0.0 and ships a known first-login password.
#
# These mirror the [admin_ui] section of zorkbot.toml. Leave a line commented
# out to let the TOML value apply; uncomment it to override the TOML.

# Master switch. Nothing listens on the admin port unless this is true.
# ADMIN_UI_ENABLED=false

# Listen address inside the container. 127.0.0.1 restricts it to the container
# itself (which makes the published port unreachable — use 0.0.0.0 under Docker).
# ADMIN_UI_BIND=0.0.0.0

# Admin UI port. Used on BOTH sides of the published mapping, so setting it here
# changes the host port and the in-container listen port together. Prefer this
# over [admin_ui].port in the TOML, which changes only the container side and
# would leave the mapping pointing at the wrong port.
# ADMIN_UI_PORT=8081

# SQLite file for admin events. Must stay under /data — that is the mounted
# volume (./data/admin on the host); anything else is lost on container restart.
# ADMIN_UI_DB=/data/admin.db
