# Copy to .env and edit before starting the stack.
#
#   cp .env.example .env

# Required. Shared by game and zorkbot for admin commands.
ADMIN_TOKEN=choose-a-long-random-secret

# Host path to the MeshCore serial device (see docs/deploy/raspberry-pi.md).
MESHCORE_DEVICE=/dev/meshcore

# Device path inside the zorkbot container (must match --serial in compose).
MESHCORE_CONTAINER_DEVICE=/dev/meshcore

# dialout group GID on the host (20 on Raspberry Pi OS / Debian).
MESHCORE_GROUP_GID=20

# Bot config file mounted into the container.
ZORKBOT_CONFIG=./zorkbot/zorkbot.toml
