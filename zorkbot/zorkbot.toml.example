# Example zorkbot config. Copy to zorkbot.toml and edit.
#
# zorkbot --serial /dev/ttyUSB0 --config zorkbot.toml

name = "zorkbot"
game_url = "http://game:8080"   # Docker Compose; use http://localhost:8080 for local dev

# packet_max_chars = 120        # max chars per outgoing radio message
# log_level = "INFO"
# announce_on_start = false

# Minimum gap between commands from one sender. This is admission control —
# it limits how many packets a sender can cause. Keep it at or above the
# airtime of a single reply, or it admits work faster than the radio drains it
# and send-queue overflow (which drops other players' packets) becomes the real
# limit:  rate_limit_seconds >= packets_per_reply * send_spacing_seconds
# A room description is ~2 packets: 4s unwatched, 12s with 2 watchers.
# rate_limit_seconds = 8.0

# Session management
# max_watchers_per_session = 2      # observers allowed per session
# session_poll_seconds = 30         # how often to check for sessions the game
#                                   # service ended on its own (inactivity
#                                   # timeout, PTY crash) so watchers can be
#                                   # notified; 0 disables polling

# Advertising (send_advert flood=True so players can DM the bot)
# advert_enabled = false    # MUST be set to true on a live server so players
#                           # can discover the bot and exchange DM keys.
# advert_flood = true       # true = flood (whole mesh, needed for DMs);
#                           # false = zerohop (directly connected nodes only)
# advert_interval_seconds = 300     # background advert timer
# advert_cooldown_seconds = 300     # min gap between adverts

# RF send serialization
# send_spacing_seconds = 2.0        # min gap between radio transmissions;
#                                   # paces egress, does not reduce packet
#                                   # count — see rate_limit_seconds above
# max_send_queue_depth = 64         # max queued packets before drops

# Mesh bot discovery (!bots roll call) — a separate channel from the game
# lobby below. Disabled by default; requires both of these to be set.
# bots_enabled = false
# [bots_channel]
# index = 2
# name = "#bots"

[channel]
index = 1
name = "#zork"

[admin]
# 12-char hex pubkey_prefix of admin users.
# Find yours in bot logs: docker compose logs zorkbot | grep player=
pubkeys = ["your-pubkey-prefix"]

# Admin web UI: LAN-accessible session monitoring + admin console, off by
# default. See "Admin web UI" in README.md before enabling. First login is
# admin / zorkbot-admin! and forces a password change. This is plaintext
# HTTP — keep it on a trusted LAN or front it with TLS / a VPN.
[admin_ui]
# enabled = false
# bind = "0.0.0.0"                  # "127.0.0.1" to restrict to the host
# port = 8081
# db_path = "/data/admin.db"
# access_token_ttl_seconds = 1800
# refresh_token_ttl_seconds = 2592000
# event_retention_days = 90
# event_queue_size = 1024
# live_buffer_events = 50
# max_live_streams = 4
