# Game data (mount at runtime)
games/*.z3

# Runtime data
data/saves/*
!data/saves/.gitkeep
data/admin/*
!data/admin/.gitkeep
# Local admin-UI runs: the container's /data mount needs root on a dev box, so
# a local zorkbot.toml points db_path at ./data instead. Same data, unprivileged
# location.
zorkbot/data/

# Local bot config (copy from zorkbot.toml.example)
zorkbot/zorkbot.toml

# Go
game/bin/
.tools/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Editor / OS
.DS_Store
*.swp
.env

# Image tarballs (docker save) in repo root
/*.tar.gz
